
<<\e[32m fastaai \e[0m>>

    version:		v.0
    avaliable database:	None
    conda env:		source activate /share/data1/software/miniconda3/envs/drep3
    URL:            https://github.com/cruizperez/FastAAI

    #  基因组的蛋白相似度
    #  简单来说就是先对基因组进行基因预测，然后再以基因组的蛋白为单位计算相似度


    ----------------------------
         << 相关命令 >>
    ----------------------------

    ## 1、第一步就是需要建立索引(数据库)
    fastaai build_db -p <\e[32m/dir/to/faas/\e[0m> -o <\e[32m /dir/to/db/ \e[0m> --threads 40 --verbose

    ## 2、计算AAI
    fastaai db_query --query <\e[32m/dir/to/db/database/FastAAI_database.sqlite.db\e[0m> \
        --target <\e[32m/dir/to/db/database/FastAAI_database.sqlite.db\e[0m>\
        --threads 40 --verbose --output <\e[32m output.res.tsv \e[0m>

