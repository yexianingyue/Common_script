#!/usr/bin/bash

# 定义命令根目录
SCRIPT_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
CMD_DIR="$SCRIPT_DIR/commands"

# 打印命令内容
print_command() {
    local cmd="$1"
    local found=0

    # 遍历所有文件，查找匹配的命令名
    while IFS= read -r -d '' file; do
        if [[ $(basename "$file") == "$cmd" ]]; then
            echo -e "\n=== Command: $cmd (路径: $CMD_DIR/$cmd) ==="
            printf "%b\n\n\n" "$(<"$file")"
            found=1
            break
        fi
    done < <(find "$CMD_DIR" \( -type f -o -type l \)  -print0)

    # 未找到时提示
    [[ $found -eq 0 ]] && echo "Error: Command or directory '$cmd' not found!" >&2
}

# 列出所有命令和目录
list_commands() {
    echo -e "\nAvailable commands and Groups:"
    echo "----------------------------------"
    
    # 列出commands目录下的所有命令
    echo -e "\nCommands:"
    echo "--------"
    find "$CMD_DIR" \( -type f -o -type l \) | sed "s|$CMD_DIR/||" | sort | xargs -I {} printf "\t%s\n" {}
    
    # 列出其他目录（排除commands目录）
    echo -e "\nGroups:"
    echo "-----------"
    for dir in "$SCRIPT_DIR"/*; do
        if [[ -d "$dir" && "$(basename "$dir")" != "commands" ]]; then
            echo -e "\t$(basename "$dir")"
        fi
    done
}

# 列出指定目录下的内容
list_directory() {
    local dir_name="$1"
    local dir_path="$SCRIPT_DIR/$dir_name"
    
    if [[ -d "$dir_path" ]]; then
        echo -e "\n<< \e[32m$dir_name\e[0m >>"
        echo "------------------------------"
        find "$dir_path" \( -type f -o -type l \) | sed "s|$dir_path/||" | sort | xargs -I {} printf "\t%s\n" {}
    else
        print_command "$dir_name"  # 如果不是目录，尝试查找命令
    fi
}

# 主逻辑
if [[ $# -eq 0 || "$1" == "-h" ]]; then
    echo "Usage: $0 <command>   # 打印命令文档"
    echo "       $0 list        # 列出所有命令和目录"
    echo "       $0 <Groups> # 列出指定分组的命令"
elif [[ "$1" == "list" ]]; then
    list_commands
else
    # 检查是否是已知目录
    if [[ -d "$SCRIPT_DIR/$1" && "$1" != "commands" ]]; then
        list_directory "$1"
    else
        print_command "$1"
    fi
fi
